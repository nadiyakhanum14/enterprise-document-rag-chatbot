# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# OpenRouter API key — get yours at https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter base URL (do not change unless using a proxy)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# LLM model served through OpenRouter
# Options: mistralai/mistral-7b-instruct, openai/gpt-4o-mini, anthropic/claude-3-haiku, etc.
LLM_MODEL=mistralai/mistral-7b-instruct

# Sentence-transformers embedding model (CPU-friendly)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Persistent ChromaDB storage path
CHROMA_DB_PATH=./chroma_db

# PDF documents folder
DOCS_PATH=./docs

# Hybrid retrieval weight: 1.0 = semantic only, 0.0 = BM25 only, 0.5 = balanced
RETRIEVAL_ALPHA=0.5

# Number of candidates fetched before re-ranking
RETRIEVAL_FETCH_K=20

# Number of final chunks passed to the LLM after re-ranking
RETRIEVAL_TOP_K=5

# Maximum conversation turns kept in memory
MAX_HISTORY_TURNS=6
